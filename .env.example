# Copy to .env for local dev. On Netlify: Site settings → Environment variables → add each key.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login
ADMIN_EMAIL=mbplingerie@gmail.com
ADMIN_PASSWORD=your-admin-password
JWT_SECRET=your-long-random-jwt-secret

# Site URLs (no trailing slash)
PUBLIC_SITE_URL=https://mbplingerie.com.ng
FRONTEND_ORIGIN=https://mbplingerie.com.ng
NEXT_PUBLIC_SITE_URL=https://mbplingerie.com.ng

# Paystack
PAYSTACK_SECRET_KEY=sk_test_or_sk_live_xxx
PAYSTACK_CALLBACK_URL=https://mbplingerie.com.ng/cart

# Resend order emails
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=MBP Lingerie <orders@mbplingerie.com.ng>
ADMIN_ORDER_EMAIL=mbplingerie@gmail.com

# Local Next → Express proxy
API_PROXY_URL=http://127.0.0.1:4000
PORT=4000
